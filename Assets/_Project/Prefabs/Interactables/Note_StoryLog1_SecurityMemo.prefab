  m_Script: {fileID: 11500000, guid: b49f37c5fa00da746b87bbc578d5a175, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _noteTitle: Apex Security — Shift Log
  _noteBody: "20:45 HRS. Shift handover to Apex Private Security complete.\n\nUniversity
    administration privatized nighttime security for the Academic Block after 9:00
    PM following recurring 'disturbances and electrical anomalies' on the upper floors.\n\nOrders
    are explicit:\n1. The Academic Block perimeter seals at 21:00 HRS sharp. No students
    permitted inside under any circumstances.\n2. Prof. Anish Mondal signed
    out the Mechatronics Lab key earlier. He hasn't checked out and may still be working
    up in the Floor 2 Mechatronics Lab.\n3. We do NOT patrol Floor 2 or enter the
    stairwells after curfew. If anyone is locked inside, they are on their own."
  _paperRustleSfx: {fileID: 0}
