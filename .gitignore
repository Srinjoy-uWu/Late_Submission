# Standard Unity .gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Visual Studio / VS Code / Rider
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.tmp
*.pdb
*.mdb

# Unity generated
sysinfo.txt
crashlytics-build.properties

# Local asset staging / raw downloaded packs (prevents LFS quota exhaustion)
_RawAssets/
_SourcePacks/
*.zip
*.rar
*.7z

# Heavy external 3D asset packs (local-only, prevents LFS quota depletion)
Assets/Imported Assets/
Assets/Imported Assets.meta
Assets/Models/
Assets/Models.meta
